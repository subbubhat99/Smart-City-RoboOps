# Optional for localhost development; required for remote/Replit access.
ROBOOPS_OPERATOR_TOKEN=
ROBOOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLite defaults to backend/data/roboops.sqlite3. Use a persistent disk for deployment.
# ROBOOPS_DATABASE=C:/path/to/persistent/roboops.sqlite3

# XProtect API Gateway origin (no /api/rest/v1 suffix).
XPROTECT_BASE_URL=
# Obtain the actual IDP endpoint from your environment documentation/discovery.
# Example only: https://your-vms-host/API/IDP/connect/token
XPROTECT_TOKEN_URL=
# This adapter supports an XProtect Basic user via password grant, not NTLM Windows login.
XPROTECT_USERNAME=
XPROTECT_PASSWORD=
XPROTECT_CLIENT_ID=GrantValidatorClient
# Trust the development environment's CA certificate; TLS verification stays enabled.
XPROTECT_CA_BUNDLE=
# Existing external/user-defined event type for publishing approved observations.
XPROTECT_EVENT_TYPE_ID=
# Incoming event type IDs used by your Hafnia plugin/analytics for obstructions.
# Keep these different from XPROTECT_EVENT_TYPE_ID to avoid ingestion loops.
XPROTECT_OBSTRUCTION_EVENT_TYPES=

# Optional direct inference. Fill only after confirming the OpenAI-compatible image
# request profile against the documentation supplied with your Hafnia environment.
# Supply the COMPLETE chat-completions URL; no provider endpoint is guessed.
HAFNIA_CHAT_COMPLETIONS_URL=
HAFNIA_API_KEY=
HAFNIA_MODEL=
# Separate secret for normalized analysis callbacks from a plugin-side adapter.
HAFNIA_WEBHOOK_TOKEN=
# Default mapping file: backend/camera-zones.json
# ROBOOPS_CAMERA_ZONES=C:/path/to/camera-zones.json

# Optional separate event poller settings.
ROBOOPS_BACKEND_URL=http://127.0.0.1:8000
ROBOOPS_POLL_SECONDS=15

# Actual VM-local Hafnia gateway. Run scripts/start-vm.ps1 for runtime prompts.
# Do NOT write the gateway password into this file; supply HAFNIA_GW_PASSWORD
# through the backend process environment or the launcher's credential prompt.
HAFNIA_GW_USER=administrator
# Opt-in TLS exception for the fixed local gateway only, never XProtect/cloud.
HAFNIA_GW_ALLOW_SELF_SIGNED=false
# Local application cap, counting submissions (including uncertain ones), UTC day.
# Other gateway clients have a separate shared allowance; this does not reserve it.
ROBOOPS_ANALYSIS_DAILY_LIMIT=20
